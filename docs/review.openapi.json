{
  "openapi": "3.1.0",
  "info": {
    "title": "HydroSmart identity review API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/api/v1/iam/me": {
      "get": {
        "summary": "Read the signed-in user's identity",
        "description": "Representative operation. The example is synthetic and shows selected fields.",
        "responses": {
          "200": {
            "description": "Successful query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "id": "demo-user-id"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
